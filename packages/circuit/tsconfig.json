{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "useDefineForClassFields": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
