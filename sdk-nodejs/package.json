{
  "name": "ethora-b2b-sdk",
  "version": "0.2.0",
  "description": "Node.js SDK for the Ethora backend B2B (server-token) API",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node examples/smoke-test.mjs",
    "prepare": "tsc"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ethora",
    "b2b",
    "chat",
    "sdk",
    "server-token"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
