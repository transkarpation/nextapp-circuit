# ── Firebase Web SDK (клієнт, браузер) ───────────────────────────────
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (сервер) ──────────────────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key.
# З завантаженого JSON візьми project_id, client_email і private_key.
# ВАЖЛИВО: private_key бери в лапки, переноси рядків лишай як літеральні \n.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Ethora B2B SDK (ethora-b2b-sdk, сервер) ──────────────────────────
# Базовий URL Ethora-бекенду (без слеша в кінці).
ETHORA_BASE_URL=https://api.example.com

# Варіант A (рекомендовано): готовий серверний токен.
# Отримується через POST /v2/apps/{appId}/server-tokens (owner user JWT) —
# відкликуваний. Якщо задано, його достатньо (ETHORA_APP_* не потрібні).
ETHORA_SERVER_TOKEN=

# Варіант B: підписати токен локально з app secret
# (EthoraB2BClient.withAppSecret — legacy, невідкликуваний).
# Потрібні ETHORA_APP_ID + ETHORA_APP_SECRET; ETHORA_TENANT_ID — опційно.
ETHORA_APP_ID=
ETHORA_APP_SECRET=
ETHORA_TENANT_ID=

# Опційно: секрет для внутрішніх запитів (client.verifyToken → x-internal-secret).
# Має збігатися з INTERNAL_REQUESTS_SECRET на стороні Ethora-інсталяції.
ETHORA_INTERNAL_SECRET=
