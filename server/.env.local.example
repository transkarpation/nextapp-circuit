# ── Firebase Web SDK (клієнт, браузер) ───────────────────────────────
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Лише для локальної розробки з Firebase Auth Emulator, наприклад http://127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=

# ── Firebase Admin SDK (сервер) ──────────────────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key.
# З завантаженого JSON візьми project_id, client_email і private_key.
# ВАЖЛИВО: private_key бери в лапки, переноси рядків лишай як літеральні \n.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
